{
  "manifest_version": 3,
  "name": "TaskFlow - Trợ lý tra cứu BHXH",
  "version": "1.1.1",
  "description": "Tiện ích kết nối trực tiếp cổng BHXH Việt Nam từ IP nội địa cho ứng dụng TaskFlow.",
  "permissions": [
    "cookies",
    "declarativeNetRequest",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://baohiemxahoi.gov.vn/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "TaskFlow - Trợ lý tra cứu BHXH",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
